-- Shared fixtures for pgTAP files, included inside each file's transaction, so
-- everything here is rolled back. Correct answer id = question id + 10000,
-- wrong answer id = question id + 20000.
create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated;

create function tests.uid(p_name text)
returns uuid
language sql
immutable
as $$
  select (case p_name
    when 'admin' then 'aaaaaaaa-0000-4000-8000-000000000001'
    when 'student' then 'bbbbbbbb-0000-4000-8000-000000000001'
    when 'second' then 'bbbbbbbb-0000-4000-8000-000000000002'
    when 'pending' then 'cccccccc-0000-4000-8000-000000000001'
    when 'rejected' then 'cccccccc-0000-4000-8000-000000000002'
    when 'unconfirmed' then 'cccccccc-0000-4000-8000-000000000003'
  end)::uuid;
$$;

create function tests.login(p_name text)
returns void
language plpgsql
as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', tests.uid(p_name), 'role', 'authenticated')::text,
    true
  );
  set local role authenticated;
end;
$$;

create function tests.login_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  set local role anon;
end;
$$;

create function tests.logout()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  reset role;
end;
$$;

create function tests.attempt(p_test_id bigint, p_user text)
returns bigint
language sql
stable
security definer
set search_path = ''
as $$
  select a.id
  from public.quiz_attempts a
  where a.test_id = p_test_id
    and a.user_id = tests.uid(p_user)
    and a.finished_at is null;
$$;

insert into auth.users (id, email, email_confirmed_at, raw_user_meta_data, aud, role)
values
  (tests.uid('admin'), 'admin@example.test', now(), '{"display_name":"Admin"}', 'authenticated', 'authenticated'),
  (tests.uid('student'), 'student@example.test', now(), '{"display_name":"Student"}', 'authenticated', 'authenticated'),
  (tests.uid('second'), 'second@example.test', now(), '{"display_name":"Second"}', 'authenticated', 'authenticated'),
  (tests.uid('pending'), 'pending@example.test', now(), '{"display_name":"Pending"}', 'authenticated', 'authenticated'),
  (tests.uid('rejected'), 'rejected@example.test', now(), '{"display_name":"Rejected"}', 'authenticated', 'authenticated'),
  (tests.uid('unconfirmed'), 'unconfirmed@example.test', null, '{"display_name":"Unconfirmed"}', 'authenticated', 'authenticated');

update public.profiles set role = 'admin' where id = tests.uid('admin');
update public.profiles set status = 'approved' where id in (tests.uid('student'), tests.uid('second'));
update public.profiles set status = 'rejected' where id = tests.uid('rejected');

