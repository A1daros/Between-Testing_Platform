insert into public.answers (id, question_id, answer_text, is_correct)
select q.id + 10000, q.id, 'Correct ' || q.id, true from public.questions q
union all
select q.id + 20000, q.id, 'Wrong ' || q.id, false from public.questions q;

update public.tests set content_updated_at = null;
